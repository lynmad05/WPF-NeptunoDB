<UserControl x:Class="WPF_SP.Views.PedidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPF_SP.ViewModels"
             Background="{StaticResource FondoPrincipal}"
             Loaded="PedidoView_Loaded">

    <UserControl.DataContext>
        <vm:PedidoViewModel />
    </UserControl.DataContext>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ENCABEZADO -->
        <Border Grid.Row="0"
                Background="#8B82C7"
                CornerRadius="14"
                Padding="24,18">

            <StackPanel>

                <TextBlock Text="Gestión de Pedidos"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Administra y consulta los pedidos registrados"
                           FontSize="13"
                           Foreground="#F2F0FC"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>


        <!-- CONTENIDO -->
        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- TAB MANTENIMIENTO -->
            <TabItem Header="Mantenimiento">

                <Grid Margin="0,16,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>


                    <!-- TABLA -->
                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="14"
                            BorderBrush="#E2DFF2"
                            BorderThickness="1">

                        <DataGrid ItemsSource="{Binding Pedidos}"
                                  SelectedItem="{Binding Seleccionado, Mode=TwoWay}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding PedidoID}"
                                                    Width="50"/>

                                <DataGridTextColumn Header="Fecha Pedido"
                                                    Binding="{Binding FechaPedido, StringFormat=d}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Fecha Req."
                                                    Binding="{Binding FechaRequerida, StringFormat=d}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Fecha Envío"
                                                    Binding="{Binding FechaEnvio, StringFormat=d}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Destinatario"
                                                    Binding="{Binding Destinatario}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Ciudad"
                                                    Binding="{Binding CiudadDestino}"
                                                    Width="100"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>


                    <!-- FORMULARIO -->
                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="14"
                            BorderBrush="#E2DFF2"
                            BorderThickness="1"
                            Padding="22">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="Mantenimiento de Pedidos"
                                           FontWeight="SemiBold"
                                           FontSize="19"
                                           Foreground="#303653"
                                           Margin="0,0,0,20"/>


                                <TextBlock Text="Cliente ID"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <TextBox Text="{Binding Actual.ClienteID, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,11"
                                         Padding="10,8"/>


                                <TextBlock Text="Empleado ID"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <TextBox Text="{Binding Actual.EmpleadoID, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,11"
                                         Padding="10,8"/>


                                <TextBlock Text="Fecha Pedido"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <DatePicker SelectedDate="{Binding Actual.FechaPedido}"
                                            Margin="0,6,0,11"/>


                                <TextBlock Text="Fecha Requerida"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <DatePicker SelectedDate="{Binding Actual.FechaRequerida}"
                                            Margin="0,6,0,11"/>


                                <TextBlock Text="Fecha Envío"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <DatePicker SelectedDate="{Binding Actual.FechaEnvio}"
                                            Margin="0,6,0,11"/>


                                <TextBlock Text="Transportista ID"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <TextBox Text="{Binding Actual.TransportistaID, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,11"
                                         Padding="10,8"/>


                                <TextBlock Text="Destinatario"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <TextBox Text="{Binding Actual.Destinatario, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,11"
                                         Padding="10,8"/>


                                <TextBlock Text="Ciudad Destino"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <TextBox Text="{Binding Actual.CiudadDestino, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,11"
                                         Padding="10,8"/>


                                <TextBlock Text="País Destino"
                                           FontWeight="SemiBold"
                                           Foreground="#69648C"/>

                                <TextBox Text="{Binding Actual.PaisDestino, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,16"
                                         Padding="10,8"/>


                                <StackPanel Orientation="Horizontal">

                                    <Button Content="Nuevo"
                                            Command="{Binding NuevoCommand}"
                                            Style="{StaticResource BotonAccion}"
                                            Background="#A9A1D8"/>

                                    <Button Content="Guardar"
                                            Command="{Binding GuardarCommand}"
                                            Style="{StaticResource BotonAccion}"
                                            Background="#8178C0"/>

                                    <Button Content="Eliminar"
                                            Command="{Binding EliminarCommand}"
                                            Style="{StaticResource BotonAccion}"
                                            Background="#C96B7B"/>

                                </StackPanel>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </TabItem>


            <!-- TAB REPORTE -->
            <TabItem Header="Reporte por Fechas">

                <Grid Margin="0,16,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- FILTROS -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="14"
                            BorderBrush="#E2DFF2"
                            BorderThickness="1"
                            Padding="16">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Desde:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#69648C"
                                       Margin="0,0,7,0"/>

                            <DatePicker SelectedDate="{Binding FechaInicioReporte}"
                                        Margin="0,0,15,0"/>


                            <TextBlock Text="Hasta:"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="#69648C"
                                       Margin="0,0,7,0"/>

                            <DatePicker SelectedDate="{Binding FechaFinReporte}"
                                        Margin="0,0,15,0"/>


                            <Button Content="Generar Reporte"
                                    Command="{Binding GenerarReporteCommand}"
                                    Style="{StaticResource BotonAccion}"
                                    Background="#8178C0"/>

                        </StackPanel>

                    </Border>


                    <!-- TABLA -->
                    <Border Grid.Row="2"
                            Background="White"
                            CornerRadius="14"
                            BorderBrush="#E2DFF2"
                            BorderThickness="1">

                        <DataGrid ItemsSource="{Binding ReporteDetalle}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Pedido"
                                                    Binding="{Binding PedidoID}"
                                                    Width="60"/>

                                <DataGridTextColumn Header="Fecha Pedido"
                                                    Binding="{Binding FechaPedido, StringFormat=d}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Cliente"
                                                    Binding="{Binding NombreCliente}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Producto"
                                                    Binding="{Binding NombreProducto}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Precio Unit."
                                                    Binding="{Binding PrecioUnidad, StringFormat=C}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Cantidad"
                                                    Binding="{Binding Cantidad}"
                                                    Width="75"/>

                                <DataGridTextColumn Header="Descuento"
                                                    Binding="{Binding Descuento, StringFormat=P0}"
                                                    Width="85"/>

                                <DataGridTextColumn Header="SubTotal"
                                                    Binding="{Binding SubTotal, StringFormat=C}"
                                                    Width="100"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>


                    <TextBlock Grid.Row="3"
                               Margin="0,13,5,0"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="#303653"
                               HorizontalAlignment="Right"
                               Text="{Binding TotalReporte, StringFormat='Total: {0:C}'}"/>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</UserControl>