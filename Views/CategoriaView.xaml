<UserControl x:Class="WPF_SP.Views.CategoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPF_SP.ViewModels"
             Background="#F5F7FC"
             Loaded="CategoriaView_Loaded">

    <UserControl.DataContext>
        <vm:CategoriaViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- Colores -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#53679E"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#3F5187"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D9DEEA"/>
        <SolidColorBrush x:Key="TextColor" Color="#27324A"/>
        <SolidColorBrush x:Key="SecondaryTextColor" Color="#737D95"/>

        <!-- Estilo DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F5"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <!-- Cabecera DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F8"/>
            <Setter Property="Foreground" Value="#45516D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Filas DataGrid -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F7FC"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E5E9F5"/>
                    <Setter Property="Foreground" Value="#27324A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Celdas -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <!-- Botones -->
        <Style x:Key="NuevoButton"
               TargetType="Button"
               BasedOn="{StaticResource BotonAccion}">
            <Setter Property="Background" Value="#E9EDF7"/>
            <Setter Property="Foreground" Value="#53679E"/>
            <Setter Property="BorderBrush" Value="#D7DDED"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GuardarButton"
               TargetType="Button"
               BasedOn="{StaticResource BotonAccion}">
            <Setter Property="Background" Value="#53679E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#53679E"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="EliminarButton"
               TargetType="Button"
               BasedOn="{StaticResource BotonAccion}">
            <Setter Property="Background" Value="#F2E9EC"/>
            <Setter Property="Foreground" Value="#8A5263"/>
            <Setter Property="BorderBrush" Value="#E7D5DC"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>


    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Categorías"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextColor}"/>

            <TextBlock Text="Administra las categorías registradas en el sistema."
                       FontSize="13"
                       Foreground="{StaticResource SecondaryTextColor}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- CONTENIDO -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>


            <!-- TABLA -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Título tabla -->
                    <Border Grid.Row="0"
                            Background="#FAFBFD"
                            BorderBrush="#EEF0F5"
                            BorderThickness="0,0,0,1"
                            Padding="18,14">

                        <Grid>

                            <TextBlock Text="Lista de categorías"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}"/>

                        </Grid>

                    </Border>


                    <DataGrid Grid.Row="1"
                              Margin="0"
                              ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding Seleccionado, Mode=TwoWay}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding CategoriaID}"
                                                Width="70"/>

                            <DataGridTextColumn Header="NOMBRE"
                                                Binding="{Binding NombreCategoria}"
                                                Width="*"/>

                            <DataGridTextColumn Header="DESCRIPCIÓN"
                                                Binding="{Binding Descripcion}"
                                                Width="2*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- PANEL DE MANTENIMIENTO -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- TÍTULO -->
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,24">

                        <TextBlock Text="Mantenimiento"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}"/>

                        <TextBlock Text="Información de la categoría"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextColor}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- NOMBRE -->
                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,18">

                        <TextBlock Text="Nombre"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}"
                                   Margin="0,0,0,7"/>

                        <TextBox Text="{Binding Actual.NombreCategoria, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40"/>

                    </StackPanel>


                    <!-- DESCRIPCIÓN -->
                    <StackPanel Grid.Row="2">

                        <TextBlock Text="Descripción"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}"
                                   Margin="0,0,0,7"/>

                        <TextBox Text="{Binding Actual.Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="100"/>

                    </StackPanel>


                    <!-- SEPARADOR -->
                    <Border Grid.Row="4"
                            Height="1"
                            Background="#EEF0F5"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,18"/>


                    <!-- BOTONES -->
                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">

                        <Button Content="Nuevo"
                                Command="{Binding NuevoCommand}"
                                Style="{StaticResource NuevoButton}"/>

                        <Button Content="Guardar"
                                Command="{Binding GuardarCommand}"
                                Style="{StaticResource GuardarButton}"/>

                        <Button Content="Eliminar"
                                Command="{Binding EliminarCommand}"
                                Style="{StaticResource EliminarButton}"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>