<UserControl x:Class="WPF_SP.Views.ProveedorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPF_SP.ViewModels"
             Background="{StaticResource FondoPrincipal}"
             Loaded="ProveedorView_Loaded">

    <UserControl.DataContext>
        <vm:ProveedorViewModel />
    </UserControl.DataContext>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>


        <!-- ENCABEZADO -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="3"
                Background="#8B82C7"
                CornerRadius="14"
                Padding="24,18">

            <StackPanel>

                <TextBlock Text="Gestión de Proveedores"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Administra proveedores y su información de contacto"
                           FontSize="13"
                           Foreground="#F2F0FC"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>


        <!-- FILTROS -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Background="White"
                CornerRadius="14"
                BorderBrush="#E2DFF2"
                BorderThickness="1"
                Padding="15">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Contacto:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#69648C"
                           Margin="0,0,7,0"/>

                <TextBox Width="150"
                         Margin="0,0,15,0"
                         Padding="9,7"
                         Text="{Binding FiltroContacto, UpdateSourceTrigger=PropertyChanged}"/>


                <TextBlock Text="Ciudad:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#69648C"
                           Margin="0,0,7,0"/>

                <TextBox Width="120"
                         Margin="0,0,15,0"
                         Padding="9,7"
                         Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}"/>


                <Button Content="Buscar"
                        Command="{Binding BuscarCommand}"
                        Style="{StaticResource BotonAccion}"
                        Background="#8178C0"/>

                <Button Content="Limpiar"
                        Command="{Binding LimpiarFiltroCommand}"
                        Style="{StaticResource BotonAccion}"
                        Background="#B8B2D9"/>

            </StackPanel>

        </Border>


        <!-- TABLA -->
        <Border Grid.Row="4"
                Grid.Column="0"
                Background="White"
                CornerRadius="14"
                BorderBrush="#E2DFF2"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding Proveedores}"
                      SelectedItem="{Binding Seleccionado, Mode=TwoWay}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding ProveedorID}"
                                        Width="50"/>

                    <DataGridTextColumn Header="Compañía"
                                        Binding="{Binding CompaniaNombre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Contacto"
                                        Binding="{Binding NombreContacto}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Ciudad"
                                        Binding="{Binding Ciudad}"
                                        Width="100"/>

                    <DataGridTextColumn Header="País"
                                        Binding="{Binding Pais}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Teléfono"
                                        Binding="{Binding Telefono}"
                                        Width="110"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- FORMULARIO -->
        <Border Grid.Row="2"
                Grid.RowSpan="3"
                Grid.Column="2"
                Background="White"
                CornerRadius="14"
                BorderBrush="#E2DFF2"
                BorderThickness="1"
                Padding="22">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Mantenimiento de Proveedores"
                               FontWeight="SemiBold"
                               FontSize="19"
                               Foreground="#303653"
                               Margin="0,0,0,20"/>


                    <TextBlock Text="Compañía"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.CompaniaNombre, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,11"
                             Padding="10,8"/>


                    <TextBlock Text="Nombre de Contacto"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.NombreContacto, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,11"
                             Padding="10,8"/>


                    <TextBlock Text="Cargo de Contacto"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.CargoContacto, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,11"
                             Padding="10,8"/>


                    <TextBlock Text="Dirección"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.Direccion, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,11"
                             Padding="10,8"/>


                    <TextBlock Text="Ciudad"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.Ciudad, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,11"
                             Padding="10,8"/>


                    <TextBlock Text="Código Postal"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.CodigoPostal, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,11"
                             Padding="10,8"/>


                    <TextBlock Text="País"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.Pais, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,11"
                             Padding="10,8"/>


                    <TextBlock Text="Teléfono"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.Telefono, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,11"
                             Padding="10,8"/>


                    <TextBlock Text="Fax"
                               FontWeight="SemiBold"
                               Foreground="#69648C"/>

                    <TextBox Text="{Binding Actual.Fax, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,16"
                             Padding="10,8"/>


                    <StackPanel Orientation="Horizontal">

                        <Button Content="Nuevo"
                                Command="{Binding NuevoCommand}"
                                Style="{StaticResource BotonAccion}"
                                Background="#A9A1D8"/>

                        <Button Content="Guardar"
                                Command="{Binding GuardarCommand}"
                                Style="{StaticResource BotonAccion}"
                                Background="#8178C0"/>

                        <Button Content="Eliminar"
                                Command="{Binding EliminarCommand}"
                                Style="{StaticResource BotonAccion}"
                                Background="#C96B7B"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>