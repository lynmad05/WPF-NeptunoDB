<Window x:Class="WPF_SP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeptunoDB - Mantenimiento" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoPrincipal}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menú superior -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Background="{StaticResource ColorPrimario}" Height="50">
            <Button Content="Productos"   Click="BtnProductos_Click"   Style="{StaticResource BotonMenu}" />
            <Button Content="Categorías"  Click="BtnCategorias_Click"  Style="{StaticResource BotonMenu}" />
            <Button Content="Proveedores" Click="BtnProveedores_Click" Style="{StaticResource BotonMenu}" />
            <Button Content="Pedidos"     Click="BtnPedidos_Click"     Style="{StaticResource BotonMenu}" />
        </StackPanel>

        <!-- Contenedor dinámico de vistas -->
        <ContentControl x:Name="ContenidoPrincipal" Grid.Row="1" Margin="10" />
    </Grid>
</Window>
